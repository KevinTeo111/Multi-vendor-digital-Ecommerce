{
  "name": "digital-marketplace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "dotenv -e .env -- npm run prisma:generate -w apps/api",
    "db:migrate": "dotenv -e .env -- npm run prisma:migrate -w apps/api",
    "db:deploy": "dotenv -e .env -- npm run migrate:apply -w apps/api",
    "db:seed": "dotenv -e .env -- npm run prisma:seed -w apps/api",
    "db:seed:demo": "dotenv -e .env -- npm run prisma:seed:demo -w apps/api",
    "db:studio": "dotenv -e .env -- npm run prisma:studio -w apps/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
