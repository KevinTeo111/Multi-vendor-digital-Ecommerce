# ---- Database ----
# Use the DIRECT host (no "-pooler") and drop any "channel_binding" parameter.
# Example for Neon: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Storage (S3 compatible: Cloudflare R2 / Amazon S3 / MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marketplace-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
DOWNLOAD_URL_TTL_SECONDS=300

# ---- Payments ----
# mock | stripe
PAYMENT_GATEWAY=mock
# Stripe secret key (sk_test_... in the sandbox, sk_live_... in production)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<api-host>/api/webhooks/payments (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
