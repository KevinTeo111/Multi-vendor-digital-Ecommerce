# ---- Database ----
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Storage (S3 compatible: Cloudflare R2 / Amazon S3 / MinIO) ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=marketplace-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
DOWNLOAD_URL_TTL_SECONDS=300

# ---- Payments ----
# mock | pagarme
PAYMENT_GATEWAY=mock
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
# Basic-auth pair configured for the webhook in the Pagar.me dashboard, as "user:password"
PAGARME_WEBHOOK_SECRET=

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public key for client-side card tokenization (leave empty with the mock gateway)
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=
